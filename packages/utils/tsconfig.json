{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "strict": true,
    "declaration": true,
    "emitDeclarationOnly": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "outDir": "./dist", // Ensure this is the output directory
    "rootDir": "./src", // Ensure this is the root directory of your source files
    "baseUrl": "./",
    "lib": ["DOM", "DOM.Iterable", "ESNext"]
  },
  "exclude": [
    "node_modules",
    "dist" // Exclude the output directory to avoid conflicts
  ]
}
