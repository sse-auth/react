{
  "name": "@sse-auth/ad1",
  "version": "1.0.0",
  "description": "A Cloudflare D1 adapter for SSE Auth.",
  "type": "module",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.js"
    }
  },
  "files": [
    "*.d.ts*",
    "*.js",
    "src"
  ],
  "private": false,
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest -c ../utils/vitest.config.ts",
    "clean": "rm -rf *.js *.d.ts*"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sse-auth/react.git"
  },
  "author": "SSE World",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/sse-auth/react/issues"
  },
  "homepage": "https://github.com/sse-auth/react#readme",
  "dependencies": {
    "@sse-auth/adapter-core": "^1.1.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241112.0",
    "@miniflare/d1": "^2.14.4",
    "better-sqlite3": "^11.5.0"
  }
}
