{
  "name": "@sse-auth/react",
  "version": "2.0.0",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "source": "index.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./provider": {
      "import": "./dist/src/providers/index.js",
      "types": "./dist/src/providers/index.d.ts"
    },
    "./css/*": "./dist/css/*",
    "./provider/*": {
      "import": "./dist/src/providers/*.js",
      "types": "./dist/src/providers/*.d.ts"
    },
    "./types/*": "./dist/src/types/*",
    "./package.json": "./package.json",
    "./*": "./*"
  },
  "files": [
    "dist",
    "src",
    "package.json",
    "README.md",
    "LICENSE",
    "index.ts"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "clean": "rimraf dist",
    "build:css": "sass --embed-sources ./src/style.scss ./dist/css/styles.css",
    "build": "rimraf dist && npm run build:css && cross-env NODE_ENV=production rollup -c",
    "tsc": "rimraf dist && tsc",
    "css": "npx tailwindcss -o ./dist/css/style.css"
  },
  "author": "SSE World",
  "license": "MIT",
  "description": "A Library for Oauth Designed By SSE",
  "devDependencies": {
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-typescript": "^12.1.1",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.8.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "cross-env": "^7.0.3",
    "rimraf": "^6.0.1",
    "rollup": "^4.24.2",
    "sass": "^1.80.4",
    "typescript": "^5.6.3"
  },
  "dependencies": {
    "@rollup/plugin-terser": "^0.4.4",
    "@sse-auth/types": "file:packages/types/sse-auth-types-1.0.0.tgz",
    "@tailus/themer": "^0.1.8",
    "axios": "^1.7.7",
    "buffer": "^6.0.3",
    "jsonwebtoken": "^9.0.2",
    "jws": "^4.0.0",
    "lucide-react": "^0.454.0",
    "react": "^18.3.1",
    "tailwind-merge": "^2.5.4"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sse-auth/react.git"
  },
  "bugs": {
    "url": "https://github.com/sse-auth/react/issues"
  },
  "homepage": "https://github.com/sse-auth/react#readme"
}
